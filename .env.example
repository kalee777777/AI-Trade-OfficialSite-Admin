# ============================================================
# AI Trade Official Site — 环境变量样例
# 复制为 .env.local 后按需修改；全部留空也能本地跑通（零配置）
# ============================================================

# --- Admin 后台 ---
# 初始管理密码：首次启动建库时写入数据库（默认 admin123）。
# 之后的改密请走 后台「设置 → 修改密码」（存库，全平台可用）。
# ADMIN_PASSWORD=change-me

# --- 会话加密密钥（生产建议配置，≥32 字符随机串）---
# SESSION_SECRET=

# --- 数据库双模式 ---
# 留空 = 本地 SQLite 文件 data/site.db（零配置，默认；首次启动自动建库并灌入模板内容）
# 配置后 = Turso 云端模式（Vercel 部署必须，https://turso.tech 免费额度）
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# --- 询盘邮件通知（可选，默认关闭）---
# NOTIFY_EMAIL_TO=
# RESEND_API_KEY=
